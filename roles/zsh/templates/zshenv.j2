admin-cli() {
  vault_env=${1}
  shift
  (
    if [[ ${vault_env} == 'production' ]]
    then
      echo "-----------------------------"
      echo "✨🌈🔥 PROD MODE #YOLO 🔥🌈✨"
      echo "-----------------------------"
      export REALM=prod
    fi  
    cd ~/src/amber/core/packages/admin-cli && aws-vault exec ${vault_env} -- npm run start -- ${@}
  )
}

